<!-- The launcher shortcut "Start workout". A static shortcut needs the literal package, so the debug
     build has its own copy of this file (src/debug) with app.fit.debug. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
  <shortcut
    android:enabled="true"
    android:icon="@mipmap/ic_launcher"
    android:shortcutId="start_workout"
    android:shortcutLongLabel="@string/shortcut_start_workout_long"
    android:shortcutShortLabel="@string/shortcut_start_workout">
    <intent
      android:action="app.fit.action.START_WORKOUT"
      android:targetClass="app.fit.android.MainActivity"
      android:targetPackage="app.fit" />
  </shortcut>
</shortcuts>
